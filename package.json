{
  "name": "website-bot",
  "version": "2.0.0",
  "description": "L9 Website Factory — multi-stage pipeline, SEO-Bot parity build",
  "type": "module",
  "scripts": {
    "pipeline": "npx tsx scripts/run-pipeline.ts",
    "pipeline:dry": "npx tsx scripts/run-pipeline.ts --dry-run --spec=fixtures/ci-test-spec.yaml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "normalize-spec": "npx tsx scripts/normalize-spec.ts",
    "normalize-spec:check": "npx tsx scripts/normalize-spec.ts --check",
    "validate": "node scripts/verify-launch-env.mjs",
    "verify:launch-env": "node scripts/verify-launch-env.mjs",
    "verify:visual-qa": "node scripts/verify-visual-qa.mjs",
    "verify:preflight": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:preflight",
    "verify:source": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:source",
    "verify:build": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:build",
    "verify:smoke": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:smoke",
    "verify:form": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:form",
    "verify:analytics": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:analytics",
    "verify:crm": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:crm",
    "verify:seo": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:seo",
    "verify:rollback": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:rollback",
    "verify:all": "npm --prefix examples/supplemental-insurance-pros/astro_site run verify:all"
  },
  "dependencies": {
    "@quantum-l9/llm-router": "^1.0.0",
    "better-sqlite3": "^9.4.3",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.13.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
