{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantum-l9:website-bot:release-receipt:v2",
  "title": "Website-Bot Release Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "build_id",
    "client_id",
    "mode",
    "status",
    "missing_gates",
    "evidence",
    "correlation",
    "qa",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "website-bot.release-receipt/v2"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["plan", "local-proof", "publish-proof", "end-to-end"]
    },
    "status": {
      "enum": ["planned", "partial", "succeeded", "failed"]
    },
    "missing_gates": {
      "type": "array",
      "items": {
        "enum": [
          "assembly",
          "local_build",
          "github_publication",
          "vercel_deployment",
          "visual_qa",
          "lead_capture"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly"],
      "properties": {
        "assembly": {
          "$ref": "#/$defs/reference"
        },
        "build": {
          "$ref": "#/$defs/reference"
        },
        "publication": {
          "$ref": "#/$defs/reference"
        },
        "deployment": {
          "$ref": "#/$defs/reference"
        },
        "failure": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_digest", "all_required_identities_match"],
      "properties": {
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dist_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "deployment_id": {
          "type": "string",
          "minLength": 1
        },
        "all_required_identities_match": {
          "type": "boolean"
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seo_baseline", "visual_qa"],
      "properties": {
        "seo_baseline": {
          "enum": ["pending", "passed", "failed", "skipped"]
        },
        "visual_qa": {
          "enum": ["pending", "passed", "failed", "skipped"]
        }
      }
    },
    "lead_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "cta_rendered"],
      "properties": {
        "status": {
          "enum": ["verified", "not_configured", "failed", "skipped", "unverified"]
        },
        "method": {
          "enum": ["test_submission", "none"]
        },
        "endpoint_origin": {
          "type": "string",
          "pattern": "^https://[^/?#]+$"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "cta_rendered": {
          "type": "boolean"
        }
      }
    },
    "readiness": {
      "$ref": "#/$defs/readiness_ladder"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "logical_id", "relative_path", "sha256"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "assembly",
            "build",
            "publication",
            "deployment",
            "release",
            "handoff",
            "registration_ack",
            "failure"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|(^|/)\\.\\.(/|$))"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "readiness_ladder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "levels"],
      "description": "Explicit readiness per build: six distinct levels, each judged on its own evidence; a level is never inferred from another.",
      "properties": {
        "schema": {
          "const": "website-bot.readiness-ladder/v1"
        },
        "levels": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/readiness_entry"
                },
                {
                  "properties": {
                    "level": {
                      "const": "structural_ci"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/readiness_entry"
                },
                {
                  "properties": {
                    "level": {
                      "const": "replay_quality_gate"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/readiness_entry"
                },
                {
                  "properties": {
                    "level": {
                      "const": "live_provider_canary"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/readiness_entry"
                },
                {
                  "properties": {
                    "level": {
                      "const": "client_build_quality_check"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/readiness_entry"
                },
                {
                  "properties": {
                    "level": {
                      "const": "blind_judge_vs_baseline"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/readiness_entry"
                },
                {
                  "properties": {
                    "level": {
                      "const": "operator_deploy_approval"
                    }
                  }
                }
              ]
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "readiness_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "state", "evidence_ref"],
      "properties": {
        "level": {
          "enum": [
            "structural_ci",
            "replay_quality_gate",
            "live_provider_canary",
            "client_build_quality_check",
            "blind_judge_vs_baseline",
            "operator_deploy_approval"
          ]
        },
        "state": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "evidence_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["PASS", "FAIL"]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["NOT_RUN", "BLOCKED"]
              }
            }
          },
          "then": {
            "required": ["reason"]
          }
        }
      ]
    }
  },
  "x_l9_meta": {
    "layer": "contract",
    "role": "persisted_schema",
    "status": "active",
    "version": "2.1.0"
  }
}
