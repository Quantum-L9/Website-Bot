---
import { siteConfig } from "../lib/siteConfig";
import type { StructuredSectionView } from "./SectionRegistry";
import StructuredBlocks from "./StructuredBlocks.astro";

interface Props {
  content?: string;
  /** REDESIGN_IMPROVE accepted section; its copy renders semantically above the form. */
  structured?: StructuredSectionView;
}
const { content = "", structured } = Astro.props;
// Only a verified HTTPS action (validated by the assembler) renders a live form.
// Without one the section stays informational and says inquiries are not
// enabled, instead of offering a submit that cannot reach anyone (WB-QAP-03).
const action = siteConfig.leadFormAction;
const cta = siteConfig.primaryCta;
const paragraphs = content
  .split(/\n{2,}/)
  .map((value) => value.trim().replace(/\*\*/g, ""))
  .filter(Boolean);
const heading =
  (structured ? (structured.heading ?? structured.eyebrow) : paragraphs[0]) ||
  cta?.label ||
  `Contact ${siteConfig.businessName}`;
const phone = siteConfig.phone;
const allRoutes: Array<{ href: string; title: string }> =
  (siteConfig as unknown as { routes?: Array<{ href: string; title: string }> }).routes ?? [];
const serviceOptions = allRoutes.filter(
  (route) => route.href.startsWith("/services/") && route.href !== "/services/",
);
---
<section id={action ? "quote" : undefined} class="lead-form" data-section="contact_form" data-section-id={structured?.sectionId}>
  <h2>{heading}</h2>
  {structured ? (
    <>
      {structured.subheading && <p>{structured.subheading}</p>}
      <StructuredBlocks blocks={structured.blocks} />
    </>
  ) : (
    paragraphs.slice(1).map(paragraph => <p>{paragraph}</p>)
  )}
  {phone && <p class="lead-form__phone">Call or text <a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a></p>}
  {action ? (
  <form method="post" action={action} data-lead-form>
    <div class="lead-form__grid">
      <label>Name <input name="name" autocomplete="name" required /></label>
      <label>Phone <input type="tel" name="phone" autocomplete="tel" required /></label>
      <label>Email <input type="email" name="email" autocomplete="email" required /></label>
      <label>Service needed
        <select name="service" required>
          <option value="">Select a service</option>
          {serviceOptions.map(service => <option value={service.href}>{service.title}</option>)}
          <option value="other">Something else</option>
        </select>
      </label>
    </div>
    <label>Project details <textarea name="message" rows="5" required></textarea></label>
    <p class="lead-form__consent">By submitting, you agree to be contacted by phone, text, or email about your project.</p>
    <button class="btn" type="submit" data-cta>{cta?.label ?? "Submit"}</button>
  </form>
  ) : (
    <p class="lead-form__unavailable" role="note">Online inquiries are not yet enabled in this preview.</p>
  )}
</section>
