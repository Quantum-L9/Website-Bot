<!-- L9_META: layer=template, role=section_renderer, status=active, version=1.2.0 -->
---
import LeadForm from "./LeadForm.astro";
import AudiencePaths from "./sections/AudiencePaths.astro";
import ComplianceNote from "./sections/ComplianceNote.astro";
import Confirmation from "./sections/Confirmation.astro";
import CtaBanner from "./sections/CtaBanner.astro";
import DiagramSection from "./sections/DiagramSection.astro";
import EditorialSection from "./sections/EditorialSection.astro";
import Faq from "./sections/Faq.astro";
import Gallery from "./sections/Gallery.astro";
import Hero from "./sections/Hero.astro";
import Process from "./sections/Process.astro";
import ProseSection from "./sections/ProseSection.astro";
import ServiceArea from "./sections/ServiceArea.astro";
import ServicesGrid from "./sections/ServicesGrid.astro";
import TrustBar from "./sections/TrustBar.astro";
import VisualEnhancementSlot from "./VisualEnhancementSlot.astro";
import { slotForSection } from "../lib/visualEnhancements";

interface Props {
  name: string;
  content: string;
  layout?: string;
}
const { name, content, layout } = Astro.props;
const registry: Record<string, any> = {
  hero: Hero,
  trust_bar: TrustBar,
  process: Process,
  audience_paths: AudiencePaths,
  service_area: ServiceArea,
  cta: CtaBanner,
  final_cta: CtaBanner,
  compliance_note: ComplianceNote,
  disclaimer: ComplianceNote,
  faq: Faq,
  confirmation: Confirmation,
  contact_form: LeadForm,
  gallery: Gallery,
  services_overview: ServicesGrid,
};
// Opt-in layout variants replace only the generic prose fallback. An explicit
// layout this template cannot realize fails the build instead of rendering
// generic prose as if the request had been honored.
const layoutVariants: Record<string, any> = {
  editorial: EditorialSection,
  diagram: DiagramSection,
};
if (layout !== undefined && !layoutVariants[layout]) {
  throw new Error(`unsupported-layout: section ${name} requests layout ${JSON.stringify(layout)}`);
}
const Component = registry[name] ?? (layout ? layoutVariants[layout] : undefined) ?? ProseSection;
// Sections with a noncritical visual region sit inside an enhancement slot. The
// slot always renders the section unchanged and is a pure passthrough while
// disabled, which is every slot by default (WB-QAP-02).
const visualSlot = slotForSection(name);
---
{visualSlot ? (
  <VisualEnhancementSlot slot={visualSlot}>
    <Component name={name} content={content} />
  </VisualEnhancementSlot>
) : (
  <Component name={name} content={content} />
)}
