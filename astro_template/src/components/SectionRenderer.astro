---
import { siteConfig } from "../lib/siteConfig";
import { slotForSection } from "../lib/visualEnhancements";
import LeadForm from "./LeadForm.astro";
import type { StructuredSectionView } from "./SectionRegistry";
import AudiencePaths from "./sections/AudiencePaths.astro";
import ComplianceNote from "./sections/ComplianceNote.astro";
import Confirmation from "./sections/Confirmation.astro";
import CtaBanner from "./sections/CtaBanner.astro";
import DiagramSection from "./sections/DiagramSection.astro";
import EditorialSection from "./sections/EditorialSection.astro";
import Faq from "./sections/Faq.astro";
import Gallery from "./sections/Gallery.astro";
import Hero from "./sections/Hero.astro";
import Process from "./sections/Process.astro";
import ProseSection from "./sections/ProseSection.astro";
import ServiceArea from "./sections/ServiceArea.astro";
import ServicesGrid from "./sections/ServicesGrid.astro";
import TrustBar from "./sections/TrustBar.astro";
import VisualEnhancementSlot from "./VisualEnhancementSlot.astro";

interface Props {
  name: string;
  content: string;
  layout?: string;
  /** Image placement the assembler bound to this section (a siteConfig.images key). */
  imagePlacement?: string | null;
  /**
   * REDESIGN_IMPROVE: the accepted structured section (WB-GLUE-01). Components
   * that consume it render its blocks semantically; `content` stays the
   * legacy text projection for components that do not.
   */
  structured?: StructuredSectionView;
}
const { name, content, layout, imagePlacement, structured } = Astro.props;
const registry: Record<string, any> = {
  hero: Hero,
  trust_bar: TrustBar,
  process: Process,
  audience_paths: AudiencePaths,
  service_area: ServiceArea,
  cta: CtaBanner,
  final_cta: CtaBanner,
  compliance_note: ComplianceNote,
  disclaimer: ComplianceNote,
  faq: Faq,
  confirmation: Confirmation,
  contact_form: LeadForm,
  gallery: Gallery,
  services_overview: ServicesGrid,
};
// Opt-in layout variants replace only the generic prose fallback. An explicit
// layout this template cannot realize fails the build instead of rendering
// generic prose as if the request had been honored.
const layoutVariants: Record<string, any> = {
  editorial: EditorialSection,
  diagram: DiagramSection,
};
if (layout !== undefined && !layoutVariants[layout]) {
  throw new Error(`unsupported-layout: section ${name} requests layout ${JSON.stringify(layout)}`);
}
const Component = registry[name] ?? (layout ? layoutVariants[layout] : undefined) ?? ProseSection;
// Sections with a noncritical visual region sit inside an enhancement slot. The
// slot always renders the section unchanged and is a pure passthrough while
// disabled, which is every slot by default (WB-QAP-02).
const visualSlot = slotForSection(name);
// The assembler binds a section only to a published placement, so a binding the
// registry does not publish is a broken build, never an image to drop. The
// generated siteConfig is `as const`; the explicit record type keeps a string
// index well-typed (same pattern as Hero.astro).
const images: Record<
  string,
  { src: string; alt: string; width: number; height: number; source?: string }
> = siteConfig.images ?? {};
const image = imagePlacement ? images[imagePlacement] : undefined;
if (imagePlacement && !image) {
  throw new Error(
    `unpublished-image-placement: section ${name} binds ${JSON.stringify(imagePlacement)}, which siteConfig.images does not publish`,
  );
}
// Hero.astro renders its own image and the gallery shows its bound image in its
// grid; every other bound section renders its image beside its content.
const galleryImage = name === "gallery" ? image : undefined;
const contentImage = name === "hero" || name === "gallery" ? undefined : image;
const blockVariant =
  name === "services_overview" ? "content-block--stacked" : "content-block--split";
---
{contentImage ? (
  visualSlot ? (
    <VisualEnhancementSlot slot={visualSlot}>
      <div class:list={["content-block", blockVariant]} data-image-placement={imagePlacement}>
        <Component name={name} content={content} structured={structured} />
        <figure class="content-block__visual">
          <img src={contentImage.src} alt={contentImage.alt} width={contentImage.width} height={contentImage.height} loading="lazy" decoding="async" sizes="(min-width: 800px) 45vw, 100vw" data-asset-source={contentImage.source} />
        </figure>
      </div>
    </VisualEnhancementSlot>
  ) : (
    <div class:list={["content-block", blockVariant]} data-image-placement={imagePlacement}>
      <Component name={name} content={content} structured={structured} />
      <figure class="content-block__visual">
        <img src={contentImage.src} alt={contentImage.alt} width={contentImage.width} height={contentImage.height} loading="lazy" decoding="async" sizes="(min-width: 800px) 45vw, 100vw" data-asset-source={contentImage.source} />
      </figure>
    </div>
  )
) : galleryImage ? (
  visualSlot ? (
    <VisualEnhancementSlot slot={visualSlot}>
      <Component name={name} content={content} structured={structured} image={galleryImage} />
    </VisualEnhancementSlot>
  ) : (
    <Component name={name} content={content} structured={structured} image={galleryImage} />
  )
) : visualSlot ? (
  <VisualEnhancementSlot slot={visualSlot}>
    <Component name={name} content={content} structured={structured} />
  </VisualEnhancementSlot>
) : (
  <Component name={name} content={content} structured={structured} />
)}
