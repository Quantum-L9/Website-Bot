<!-- L9_META: layer=template, role=services_grid_section, status=active, version=1.0.0 -->
---
import { siteConfig } from "../../lib/siteConfig";

interface Props {
  name?: string;
  content?: string;
}
const { name = "services_overview", content = "" } = Astro.props;
const paragraphs = content
  .split(/\n{2,}/)
  .map((value) => value.trim().replace(/\*\*/g, ""))
  .filter(Boolean);
const heading = paragraphs[0] || "Our Services";
const allRoutes: Array<{ href: string; title: string }> =
  (siteConfig as unknown as { routes?: Array<{ href: string; title: string }> }).routes ?? [];
const images: Record<string, { src: string; alt: string; width: number; height: number }> =
  siteConfig.images ?? {};
const services = allRoutes.filter(
  (route) => route.href.startsWith("/services/") && route.href !== "/services/",
);
---
<section class="services-grid" data-section={name}>
  <h2>{heading}</h2>
  {paragraphs.slice(1).map(paragraph => <p class="services-grid__intro">{paragraph}</p>)}
  <div class="services-grid__cards">
    {services.map(service => {
      const hero = images[`${service.href}:hero`];
      return (
        <a class="service-card" href={service.href}>
          {hero && <img class="service-card__image" src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} loading="lazy" decoding="async" />}
          <span class="service-card__title">{service.title}</span>
          <span class="service-card__cta">Learn more →</span>
        </a>
      );
    })}
  </div>
</section>
