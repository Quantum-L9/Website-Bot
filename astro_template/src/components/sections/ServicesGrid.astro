---
import { siteConfig } from "../../lib/siteConfig";
import type { StructuredSectionView } from "../SectionRegistry";
import StructuredBlocks from "../StructuredBlocks.astro";

interface Props {
  name?: string;
  content?: string;
  /** REDESIGN_IMPROVE accepted section; rendered semantically when present. */
  structured?: StructuredSectionView;
}
const { name = "services_overview", content = "", structured } = Astro.props;
const paragraphs = content
  .split(/\n{2,}/)
  .map((value) => value.trim().replace(/\*\*/g, ""))
  .filter(Boolean);
const heading = paragraphs[0] || "Our Services";
const allRoutes: Array<{ href: string; title: string }> =
  (siteConfig as unknown as { routes?: Array<{ href: string; title: string }> }).routes ?? [];
const images: Record<
  string,
  { src: string; alt: string; width: number; height: number; source?: string }
> =
  siteConfig.images ?? {};
// A route's second services section keeps its own copy but never repeats the cards.
const showCards = structured?.serviceCards !== false;
const services = allRoutes.filter(
  (route) => route.href.startsWith("/services/") && route.href !== "/services/",
);
---
<section class="services-grid" data-section={name} data-section-id={structured?.sectionId}>
  {structured ? (
    <>
      <h2>{structured.heading ?? structured.eyebrow ?? "Our Services"}</h2>
      {structured.subheading && <p class="services-grid__intro">{structured.subheading}</p>}
      <div class="services-grid__intro"><StructuredBlocks blocks={structured.blocks} /></div>
    </>
  ) : (
    <>
      <h2>{heading}</h2>
      {paragraphs.slice(1).map(paragraph => <p class="services-grid__intro">{paragraph}</p>)}
    </>
  )}
  {showCards && <div class="services-grid__cards">
    {services.map(service => {
      const hero = images[`${service.href}:hero`];
      return (
        <a class="service-card" href={service.href}>
          {hero && <img class="service-card__image" src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} loading="lazy" decoding="async" data-asset-source={hero.source} />}
          <span class="service-card__title">{service.title}</span>
          <span class="service-card__cta">Learn more →</span>
        </a>
      );
    })}
  </div>}
  {structured?.cta && <p class="services-grid__cta"><a class="btn btn--primary" href={structured.cta.href}>{structured.cta.label}</a></p>}
</section>
