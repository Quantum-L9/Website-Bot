---
import type { StructuredSectionView } from "../SectionRegistry";
import StructuredBlocks from "../StructuredBlocks.astro";

interface Props {
  name?: string;
  content: string;
  /** REDESIGN_IMPROVE accepted section; rendered semantically when present. */
  structured?: StructuredSectionView;
}
const { name = "section", content, structured } = Astro.props;
const paragraphs = content
  .split(/\n{2,}/)
  .map((value) => value.trim())
  .filter(Boolean);
const heading =
  paragraphs.length > 1 && paragraphs[0].length <= 90 ? paragraphs.shift() : undefined;
const lead = paragraphs.shift();
const label = name.replaceAll("_", " ");
---
{structured ? (
<section class="editorial" data-section={name} data-layout="editorial" data-section-id={structured.sectionId}>
  <header class="editorial__header">
    <p class="editorial__eyebrow">{(structured.heading && structured.eyebrow) || label}</p>
    <h2 class="editorial__title">{structured.heading ?? structured.eyebrow ?? label}</h2>
  </header>
  <div class="editorial__body">
    {structured.subheading && <p class="editorial__lead">{structured.subheading}</p>}
    <StructuredBlocks blocks={structured.blocks} />
    {structured.cta && <p><a class="btn btn--primary" href={structured.cta.href}>{structured.cta.label}</a></p>}
  </div>
</section>
) : (
<section class="editorial" data-section={name} data-layout="editorial">
  <header class="editorial__header">
    <p class="editorial__eyebrow">{label}</p>
    <h2 class="editorial__title">{heading ?? label}</h2>
  </header>
  <div class="editorial__body">
    {lead && <p class="editorial__lead">{lead}</p>}
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
)}
<style>
  .editorial {
    display: grid;
    gap: 1rem 2.5rem;
    padding-block: 2.5rem;
    border-top: 2px solid var(--color-primary);
  }
  .editorial__eyebrow {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .editorial__title {
    margin: 0.35rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.15;
  }
  .editorial__body {
    max-width: 65ch;
  }
  .editorial__body p {
    margin: 0 0 1rem;
    line-height: 1.7;
  }
  .editorial__lead {
    font-size: 1.2rem;
    font-weight: 600;
  }
  @media (min-width: 800px) {
    .editorial {
      grid-template-columns: minmax(12rem, 1fr) 2fr;
      align-items: start;
    }
  }
</style>
