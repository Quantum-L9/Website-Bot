<!-- L9_META: layer=template, role=diagram_section, status=active, version=1.0.0 -->
---
interface Props {
  name?: string;
  content: string;
}
const { name = "section", content } = Astro.props;
const paragraphs = content
  .split(/\n{2,}/)
  .map((value) => value.trim())
  .filter(Boolean);
const heading = paragraphs.length > 1 && paragraphs[0].length <= 90 ? paragraphs.shift() : undefined;
const label = name.replaceAll("_", " ");
---
<section class="diagram" data-section={name} data-layout="diagram">
  <h2 class="diagram__title">{heading ?? label}</h2>
  <ol class="diagram__nodes">
    {paragraphs.map((paragraph, index) => (
      <li class="diagram__node">
        <span class="diagram__marker" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <p>{paragraph}</p>
      </li>
    ))}
  </ol>
</section>
<style>
  .diagram {
    padding-block: 2.5rem;
  }
  .diagram__title {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
  }
  .diagram__nodes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .diagram__node {
    position: relative;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 45%, transparent);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--color-primary) 6%, var(--color-background));
  }
  .diagram__node + .diagram__node::before {
    content: "";
    position: absolute;
    left: 1.6rem;
    top: -1.5rem;
    height: 1.5rem;
    border-left: 2px solid var(--color-primary);
  }
  .diagram__node p {
    margin: 0.4rem 0 0;
    line-height: 1.6;
  }
  .diagram__marker {
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--color-primary);
  }
  @media (min-width: 800px) {
    .diagram__nodes {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
    .diagram__node + .diagram__node::before {
      left: -1.5rem;
      top: 50%;
      width: 1.5rem;
      height: 0;
      border-left: 0;
      border-top: 2px solid var(--color-primary);
    }
  }
</style>
