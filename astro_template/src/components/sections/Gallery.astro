---
import { siteConfig } from "../../lib/siteConfig";
import type { StructuredSectionView } from "../SectionRegistry";
import StructuredBlocks from "../StructuredBlocks.astro";

// siteConfig is emitted `as const`, so an empty galleryImages becomes `never[]`
// in text-only builds; the explicit element type keeps .map() well-typed.
type GalleryImage = { src: string; alt: string; width: number; height: number; source?: string };

interface Props {
  name?: string;
  content?: string;
  /** Planned gallery/project-proof image the assembler bound to this section. */
  image?: GalleryImage;
  /** REDESIGN_IMPROVE accepted section; rendered semantically when present. */
  structured?: StructuredSectionView;
}
const { name = "gallery", content = "", image, structured } = Astro.props;
const gallery: readonly GalleryImage[] = siteConfig.galleryImages ?? [];
// The bound (planned, possibly generated) image leads; source-site extras follow.
const items: GalleryImage[] = [];
for (const candidate of image ? [image, ...gallery] : gallery) {
  if (!items.some((entry) => entry.src === candidate.src)) items.push(candidate);
}
const paragraphs = content
  .split(/\n{2,}/)
  .map((value) => value.trim().replace(/\*\*/g, ""))
  .filter(Boolean);
// Link to the full gallery only when the site publishes that route.
const allRoutes: Array<{ href: string; title: string }> =
  (siteConfig as unknown as { routes?: Array<{ href: string; title: string }> }).routes ?? [];
const hasGalleryRoute = allRoutes.some((route) => route.href === "/gallery");
---
{/* Accepted structured copy still renders when no image is available. */}
{(items.length > 0 || structured) && (
  <section class="gallery" data-section={name} data-section-id={structured?.sectionId}>
    {structured ? (
      <>
        <h2>{structured.heading ?? structured.eyebrow ?? 'Our Work'}</h2>
        {structured.subheading && <p>{structured.subheading}</p>}
        <StructuredBlocks blocks={structured.blocks} />
      </>
    ) : (
      <>
        <h2>{paragraphs[0] || 'Our Work'}</h2>
        {paragraphs.slice(1).map(paragraph => <p>{paragraph}</p>)}
      </>
    )}
    {items.length > 0 && (
    <div class="gallery-grid">
      {items.slice(0, 7).map(entry => (
        <img src={entry.src} alt={entry.alt} width={entry.width} height={entry.height} loading="lazy" decoding="async" data-asset-source={entry.source} />
      ))}
      {hasGalleryRoute && (
        <a class="gallery-cta" href="/gallery">
          <span>See all our work</span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
    )}
  </section>
)}
