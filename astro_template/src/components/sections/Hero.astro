---
import { siteConfig } from "../../lib/siteConfig";
import type { StructuredSectionView } from "../SectionRegistry";
import StructuredBlocks from "../StructuredBlocks.astro";

interface Props {
  name?: string;
  content: string;
  /** REDESIGN_IMPROVE accepted section; rendered semantically when present. */
  structured?: StructuredSectionView;
}
const { name = "hero", content, structured } = Astro.props;
const firstNewline = content.indexOf("\n");
const headline =
  (firstNewline === -1 ? content : content.slice(0, firstNewline)).trim() || "Welcome";
const rest = firstNewline === -1 ? "" : content.slice(firstNewline + 1);
const paragraphs = rest
  .split(/\n{2,}/)
  .map((value) => value.trim())
  .filter(Boolean);
const images: Record<
  string,
  { src: string; alt: string; width: number; height: number; source?: string }
> = siteConfig.images ?? {};
const path = Astro.url.pathname !== "/" ? Astro.url.pathname.replace(/\/$/, "") : "/";
const logo = images["global:logo"];
const rawHero = images[`${path}:hero`];
const heroImage = rawHero && logo && rawHero.src === logo.src ? undefined : rawHero;
const phone = siteConfig.phone;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : undefined;
// Verified label + destination, or null: no default offer and no dead anchor (WB-QAP-03).
// A structured section's own resolved CTA replaces it, so the hero never shows two.
const cta = structured?.cta ?? siteConfig.primaryCta;
// The approved heading owns the page H1; the legacy headline is its fallback.
const structuredHeadline = structured?.heading;
// Without a heading the legacy headline already is the eyebrow; never repeat it.
const eyebrow = (structuredHeadline && structured?.eyebrow) || siteConfig.businessName;
---
<section class={heroImage ? 'hero hero--image' : 'hero'} data-section={name} data-section-id={structured?.sectionId}>
  <div class="hero__content">
    <p class="eyebrow">{eyebrow}</p>
    {structured ? (
      <>
        <h1>{structuredHeadline ?? headline}</h1>
        {structured.subheading && <p class="hero__subheading">{structured.subheading}</p>}
        <StructuredBlocks blocks={structured.blocks} />
      </>
    ) : (
      <>
        <h1>{headline.replace(/\*\*/g, '')}</h1>
        {paragraphs.map(paragraph => <p>{paragraph.replace(/\*\*/g, '')}</p>)}
      </>
    )}
    {(cta || telHref) && (
      <div class="hero__actions">
        {cta && <a class="btn btn--primary" href={cta.href}>{cta.label}</a>}
        {telHref && <a class="btn btn--ghost" href={telHref}>{phone}</a>}
      </div>
    )}
  </div>
  {heroImage && (
    <img
      class="hero__image"
      src={heroImage.src}
      alt={heroImage.alt}
      width={heroImage.width}
      height={heroImage.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      data-asset-source={heroImage.source}
    />
  )}
</section>
