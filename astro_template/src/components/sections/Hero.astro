---
import { siteConfig } from "../../lib/siteConfig";

interface Props {
  name?: string;
  content: string;
}
const { name = "hero", content } = Astro.props;
const firstNewline = content.indexOf("\n");
const headline =
  (firstNewline === -1 ? content : content.slice(0, firstNewline)).trim() || "Welcome";
const rest = firstNewline === -1 ? "" : content.slice(firstNewline + 1);
const paragraphs = rest
  .split(/\n{2,}/)
  .map((value) => value.trim())
  .filter(Boolean);
const images: Record<string, { src: string; alt: string; width: number; height: number }> =
  siteConfig.images ?? {};
const path = Astro.url.pathname !== "/" ? Astro.url.pathname.replace(/\/$/, "") : "/";
const logo = images["global:logo"];
const rawHero = images[`${path}:hero`];
const heroImage = rawHero && logo && rawHero.src === logo.src ? undefined : rawHero;
const phone = siteConfig.phone;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : undefined;
// Verified label + destination, or null: no default offer and no dead anchor (WB-QAP-03).
const cta = siteConfig.primaryCta;
---
<section class={heroImage ? 'hero hero--image' : 'hero'} data-section={name}>
  <div class="hero__content">
    <p class="eyebrow">{siteConfig.businessName}</p>
    <h1>{headline.replace(/\*\*/g, '')}</h1>
    {paragraphs.map(paragraph => <p>{paragraph.replace(/\*\*/g, '')}</p>)}
    {(cta || telHref) && (
      <div class="hero__actions">
        {cta && <a class="btn btn--primary" href={cta.href}>{cta.label}</a>}
        {telHref && <a class="btn btn--ghost" href={telHref}>{phone}</a>}
      </div>
    )}
  </div>
  {heroImage && (
    <img
      class="hero__image"
      src={heroImage.src}
      alt={heroImage.alt}
      width={heroImage.width}
      height={heroImage.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}
</section>
