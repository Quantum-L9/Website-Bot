<!-- L9_META: layer=template, role=hero_section, status=active, version=1.2.0 -->
---
import { siteConfig } from '../../lib/siteConfig';
interface Props { name?: string; content: string; }
const { name = 'hero', content } = Astro.props;
const paragraphs = content.split(/\n{2,}/).map(value => value.trim()).filter(Boolean);
const images: Record<string, { src: string; alt: string; width: number; height: number }> = siteConfig.images ?? {};
const path = Astro.url.pathname !== '/' ? Astro.url.pathname.replace(/\/$/, '') : '/';
const logo = images['global:logo'];
const rawHero = images[`${path}:hero`];
const heroImage = rawHero && logo && rawHero.src === logo.src ? undefined : rawHero;
const heading = (paragraphs[0] ?? 'Welcome').replace(/\*\*/g, '');
---
<section class="hero" data-section={name}>
  <div class="hero__content">
    <p class="eyebrow">{siteConfig.businessName}</p>
    <h1>{heading}</h1>
    {paragraphs.slice(1).map(paragraph => <p>{paragraph.replace(/\*\*/g, '')}</p>)}
  </div>
  {heroImage && (
    <img
      class="hero__image"
      src={heroImage.src}
      alt={heroImage.alt}
      width={heroImage.width}
      height={heroImage.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}
</section>
