<!-- L9_META: layer=template, role=base_layout, status=active, version=1.0.0 -->
---
import { siteConfig } from '../lib/siteConfig';
import '../styles/global.css';
interface Props { title: string; description: string; noindex?: boolean; routeSchemas?: readonly object[]; }
const { title, description, noindex = false, routeSchemas = [] } = Astro.props;
const images: Record<string, { src: string; alt: string; width: number; height: number }> = siteConfig.images ?? {};
const logo = images['global:logo'];
const ogImage = images['global:og-image'];
const ogImageUrl = ogImage ? new URL(ogImage.src, siteConfig.siteUrl).toString() : undefined;
const siteUrl = String(siteConfig.siteUrl ?? '').replace(/\/$/, '');
const pathname = Astro.url.pathname
  ? (Astro.url.pathname.startsWith('/') ? Astro.url.pathname : `/${Astro.url.pathname}`)
  : '/';
const canonicalUrl = `${siteUrl}${pathname}`;
const schemas = [...siteConfig.schemas.siteWide, ...routeSchemas];
const jsonLd = schemas.map(schema => JSON.stringify(schema).replace(/</g, '\u003c'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {jsonLd.map(value => <script is:inline type="application/ld+json" set:html={value} />)}
  </head>
  <body>
    <header>
      {logo && <a href="/" class="site-logo"><img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} decoding="async" /></a>}
      <nav aria-label="Primary">{siteConfig.nav.map(item => <a href={item.href}>{item.label}</a>)}</nav>
    </header>
    <main><slot /></main>
    <footer><p>© {new Date().getFullYear()} {siteConfig.businessName}</p></footer>
  </body>
</html>
