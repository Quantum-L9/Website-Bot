---
import { siteConfig } from "../lib/siteConfig";
import "../styles/global.css";
import {
  DEFAULT_FONT_FAMILY,
  findCatalogFont,
  fontFaceCss,
  fontStack,
  type CatalogFont,
} from "../styles/fontCatalog";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  routeSchemas?: readonly object[];
  /**
   * Page H1 for routes whose sections carry none. Only the hero section emits
   * an <h1>; a route without a hero rendered zero H1s and failed the
   * rendered-site single_h1 gate (L2-S16-001). The assembler passes the route
   * title here exactly when no hero section is present.
   */
  pageHeading?: string;
}
const { title, description, noindex = false, routeSchemas = [], pageHeading } = Astro.props;
const images: Record<string, { src: string; alt: string; width: number; height: number }> =
  siteConfig.images ?? {};
const logo = images["global:logo"];
const ogImage = images["global:og-image"];
const ogImageUrl = ogImage ? new URL(ogImage.src, siteConfig.siteUrl).toString() : undefined;
const siteUrl = String(siteConfig.siteUrl ?? "").replace(/\/$/, "");
const pathname = Astro.url.pathname
  ? Astro.url.pathname.startsWith("/")
    ? Astro.url.pathname
    : `/${Astro.url.pathname}`
  : "/";
const canonicalUrl = `${siteUrl}${pathname}`;
const schemas = [...siteConfig.schemas.siteWide, ...routeSchemas];
const jsonLd = schemas.map((schema) => JSON.stringify(schema).replace(/</g, "\u003c"));
// Layout direction (WB-QAP-04): tokens DesignIntelligenceStage derived from
// approved design direction. A group is emitted only when every token in it is
// present and well formed, so an unconfigured site gets no data-design and the
// canonical styles apply unchanged.
const LAYOUT_GROUPS: Record<string, Record<string, string>> = {
  type: { layout_fs_h1: "--fs-h1", layout_fs_h2: "--fs-h2", layout_fs_h3: "--fs-h3" },
  space: { layout_section_space: "--section-space", layout_flow_gap: "--flow-gap" },
  width: { layout_content_width: "--content-width" },
  radius: { layout_radius: "--radius" },
  surface: { layout_surface: "--surface" },
  contrast: { layout_on_primary: "--color-on-primary" },
};
const SAFE_CSS_VALUE = /^[#a-z0-9.,()% +-]+$/i;
const designTokens = siteConfig.designTokens as unknown as Record<string, string | undefined>;
const designGroups: string[] = [];
const designVars: string[] = [];
for (const [group, keys] of Object.entries(LAYOUT_GROUPS)) {
  const entries = Object.entries(keys).map(
    ([token, cssVar]) => [cssVar, designTokens[token]] as const,
  );
  if (!entries.every(([, value]) => typeof value === "string" && SAFE_CSS_VALUE.test(value)))
    continue;
  designGroups.push(group);
  for (const [cssVar, value] of entries) designVars.push(`${cssVar}:${value}`);
}
// Design system v2: contrast-safe colour roles and the type/spacing scale
// DesignIntelligenceStage derived (ds_* tokens). Each is applied on its own
// when present and well formed; global.css falls back to colour-mix() defaults.
const DS_VARS: Record<string, string> = {
  ds_text: "--ds-text",
  ds_surface: "--ds-surface",
  ds_field: "--ds-field",
  ds_muted: "--ds-muted",
  ds_ink: "--ds-ink",
  ds_on_primary: "--ds-on-primary",
  ds_control_border: "--ds-control-border",
  ds_divider: "--ds-divider",
  ds_fs_display: "--step-display",
  ds_fs_h1: "--step-h1",
  ds_fs_h2: "--step-h2",
  ds_fs_h3: "--step-h3",
  ds_fs_h4: "--step-h4",
  ds_section_space: "--space-section",
};
for (const [token, cssVar] of Object.entries(DS_VARS)) {
  const value = designTokens[token];
  if (typeof value === "string" && SAFE_CSS_VALUE.test(value)) designVars.push(`${cssVar}:${value}`);
}
// Self-hosted fonts (fontCatalog.ts): only catalog families can load, so the
// stack and @font-face come from the catalog, never from free text. The
// generated tokens.css names the family; the stack here adds the right
// serif/sans fallbacks while the face loads.
const headingFont = findCatalogFont(designTokens.font_heading);
const bodyFont = findCatalogFont(designTokens.font_body);
if (headingFont) designVars.push(`--font-heading:${fontStack(headingFont)}`);
if (bodyFont) designVars.push(`--font-body:${fontStack(bodyFont)}`);
const usedFonts: CatalogFont[] = [
  headingFont ?? findCatalogFont(DEFAULT_FONT_FAMILY)!,
  bodyFont ?? findCatalogFont(DEFAULT_FONT_FAMILY)!,
];
const fontFaces = fontFaceCss(usedFonts);
const preloadFonts = [...new Set(usedFonts.map((font) => font.faces[0]!.file))];
const phone = siteConfig.phone;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : undefined;
// Footer sitemap: group every published route by its top-level segment so
// service detail / guide / area pages are reachable from every page.
const allRoutes: Array<{ href: string; title: string }> =
  (siteConfig as unknown as { routes?: Array<{ href: string; title: string }> }).routes ?? [];
const footerGroups: Array<{ label: string; items: Array<{ href: string; title: string }> }> = [];
{
  const bySegment = new Map<string, Array<{ href: string; title: string }>>();
  for (const route of allRoutes) {
    const segment = route.href === "/" ? "Home" : (route.href.split("/")[1] ?? "");
    if (!segment) continue;
    const label = segment === "Home" ? "Home" : segment.replace(/-/g, " ");
    const items = bySegment.get(label) ?? [];
    items.push(route);
    bySegment.set(label, items);
  }
  // Home first, then alphabetical groups, longest titles first inside each group.
  const ordered = [...bySegment.entries()].sort(([a], [b]) =>
    a === "Home" ? -1 : b === "Home" ? 1 : a.localeCompare(b),
  );
  for (const [label, items] of ordered) {
    footerGroups.push({
      label: label[0]!.toUpperCase() + label.slice(1),
      items: items.sort((a, b) => b.title.length - a.title.length),
    });
  }
}
---
<!doctype html>
<html lang="en" data-design={designGroups.join(" ") || undefined} style={designVars.join(";") || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {jsonLd.map(value => <script is:inline type="application/ld+json" set:html={value} />)}
    {preloadFonts.map(href => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaces} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header" data-menu="closed">
      <div class="site-header__inner">
        {logo && <a href="/" class="site-logo"><img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} decoding="async" data-image-slot="global:logo" /></a>}
        {!logo && <a href="/" class="site-wordmark">{siteConfig.businessName}</a>}
        {siteConfig.nav.length > 0 && (
          <button class="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
            <span class="site-menu-toggle__icon" aria-hidden="true"></span>
            <span class="site-menu-toggle__label">Menu</span>
          </button>
        )}
        <nav class="site-nav" id="site-nav" aria-label="Primary">{siteConfig.nav.map(item => <a href={item.href}>{item.label}</a>)}</nav>
        {telHref && <a class="btn btn-phone" href={telHref}>{phone}</a>}
      </div>
    </header>
    {/* Mobile menu: without JavaScript the toggle stays hidden and the nav
        wraps under the header; with it, the button discloses the nav and
        reports its state through aria-expanded. Escape closes and returns focus. */}
    <script is:inline>
      (() => {
        const header = document.querySelector(".site-header");
        const toggle = header && header.querySelector(".site-menu-toggle");
        if (!header || !toggle) return;
        document.documentElement.classList.add("has-menu-toggle");
        toggle.hidden = false;
        const set = (open) => {
          header.dataset.menu = open ? "open" : "closed";
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        };
        toggle.addEventListener("click", () => set(toggle.getAttribute("aria-expanded") !== "true"));
        header.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            set(false);
            toggle.focus();
          }
        });
      })();
    </script>
    <main id="main-content">{pageHeading && <h1 class="page-title">{pageHeading}</h1>}<slot /></main>
    <footer class="site-footer">
      <p data-visual-dynamic="build-year">© {new Date().getFullYear()} {siteConfig.businessName}</p>
      {footerGroups.length > 0 && (
        <nav class="footer-nav" aria-label="Footer">
          {footerGroups.map(group => (
            <div class="footer-nav__group">
              <h2>{group.label}</h2>
              {group.items.map(item => <a href={item.href}>{item.title}</a>)}
            </div>
          ))}
        </nav>
      )}
      {telHref && <p><a class="footer-phone" href={telHref}>{phone}</a></p>}
    </footer>
  </body>
</html>
