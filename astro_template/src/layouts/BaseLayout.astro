<!-- L9_META: layer=template, role=base_layout, status=active, version=1.3.0 -->
---
import { siteConfig } from "../lib/siteConfig";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  routeSchemas?: readonly object[];
}
const { title, description, noindex = false, routeSchemas = [] } = Astro.props;
const images: Record<string, { src: string; alt: string; width: number; height: number }> =
  siteConfig.images ?? {};
const logo = images["global:logo"];
const ogImage = images["global:og-image"];
const ogImageUrl = ogImage ? new URL(ogImage.src, siteConfig.siteUrl).toString() : undefined;
const siteUrl = String(siteConfig.siteUrl ?? "").replace(/\/$/, "");
const pathname = Astro.url.pathname
  ? Astro.url.pathname.startsWith("/")
    ? Astro.url.pathname
    : `/${Astro.url.pathname}`
  : "/";
const canonicalUrl = `${siteUrl}${pathname}`;
const schemas = [...siteConfig.schemas.siteWide, ...routeSchemas];
const jsonLd = schemas.map((schema) => JSON.stringify(schema).replace(/</g, "\u003c"));
const phone = siteConfig.phone;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : undefined;
// Footer sitemap: group every published route by its top-level segment so
// service detail / guide / area pages are reachable from every page.
const allRoutes: Array<{ href: string; title: string }> =
  (siteConfig as unknown as { routes?: Array<{ href: string; title: string }> }).routes ?? [];
const footerGroups: Array<{ label: string; items: Array<{ href: string; title: string }> }> = [];
{
  const bySegment = new Map<string, Array<{ href: string; title: string }>>();
  for (const route of allRoutes) {
    const segment = route.href === "/" ? "Home" : (route.href.split("/")[1] ?? "");
    if (!segment) continue;
    const label = segment === "Home" ? "Home" : segment.replace(/-/g, " ");
    const items = bySegment.get(label) ?? [];
    items.push(route);
    bySegment.set(label, items);
  }
  // Home first, then alphabetical groups, longest titles first inside each group.
  const ordered = [...bySegment.entries()].sort(([a], [b]) =>
    a === "Home" ? -1 : b === "Home" ? 1 : a.localeCompare(b),
  );
  for (const [label, items] of ordered) {
    footerGroups.push({
      label: label[0]!.toUpperCase() + label.slice(1),
      items: items.sort((a, b) => b.title.length - a.title.length),
    });
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {jsonLd.map(value => <script is:inline type="application/ld+json" set:html={value} />)}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        {logo && <a href="/" class="site-logo"><img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} decoding="async" /></a>}
        {!logo && <a href="/" class="site-wordmark">{siteConfig.businessName}</a>}
        <nav class="site-nav" aria-label="Primary">{siteConfig.nav.map(item => <a href={item.href}>{item.label}</a>)}</nav>
        {telHref && <a class="btn btn-phone" href={telHref}>{phone}</a>}
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer>
      <p>© {new Date().getFullYear()} {siteConfig.businessName}</p>
      {footerGroups.length > 0 && (
        <nav class="footer-nav" aria-label="Footer">
          {footerGroups.map(group => (
            <div class="footer-nav__group">
              <h2>{group.label}</h2>
              {group.items.map(item => <a href={item.href}>{item.title}</a>)}
            </div>
          ))}
        </nav>
      )}
      {telHref && <p><a class="footer-phone" href={telHref}>{phone}</a></p>}
    </footer>
  </body>
</html>
