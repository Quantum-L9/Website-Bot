# L9_META: layer=configuration, role=tracked_file, status=active, version=1.0.0
node_modules/
dist/
.astro/
*.log
build/
website_pack/generated/
# Pipeline run-state (default location: .l9/data/)
.l9/data/
website-bot.db
website-bot.db-shm
website-bot.db-wal

# Generated launch-env / deploy-secret reports (per-run artifacts, not source)
validation/launch_env_report.json
validation/deploy_secrets_report.json

# Test coverage artifacts (generated by c8/node --test, not source)
coverage/
**/coverage/
.nyc_output/

# L9 governance runtime state (memory receipts/locks) — not source
.l9/

# Local secrets and Claude Code machine overrides — never commit
.env
.env.local
.env.*.local
.claude/settings.local.json
.l9-worktrees/

# Safe Haven Golden run evidence and calibration fixtures (generated per run)
evidence/
tests/golden/safehaven/fixtures/

# Agent session bootstrap — injected into the checkout per session, not
# repository content. .claude/rules is a symlink into the governance clone
# (an absolute machine path) and .claude/skills is a projection of the
# governance skill library, so committing either would duplicate the
# governance SSOT and hardcode a machine path. .mcp.json is environment
# specific. A repo that later wants its own tracked Claude config can
# un-ignore the specific paths it owns.
/.claude/
/.mcp.json
