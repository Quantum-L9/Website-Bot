# L9_META: layer=configuration, role=tracked_file, status=active, version=1.0.0
node_modules/
dist/
!packages/graphiti-memory-client/dist/
!packages/graphiti-memory-client/dist/**
!packages/llm-router/dist/
!packages/llm-router/dist/**
!packages/infisical-config/dist/
!packages/infisical-config/dist/**
.astro/
*.log
build/
website_pack/generated/
# Pipeline run-state (default location: .l9/data/)
.l9/data/
website-bot.db
website-bot.db-shm
website-bot.db-wal

# Generated launch-env / deploy-secret reports (per-run artifacts, not source)
validation/launch_env_report.json
validation/deploy_secrets_report.json
astro_template/validation/*.jsonl

# Test coverage artifacts (generated by c8/node --test, not source)
coverage/
**/coverage/
.nyc_output/

# L9 governance runtime state (memory receipts/locks) — not source.
# Ignore the CONTENTS, not the directory: git cannot re-include a file whose
# parent directory is excluded, and .l9/ci.json must be tracked — it is the
# consumer-owned CI class declaration org-ci.yml reads (schema l9.ci-consumer/v1).
.l9/*
!.l9/ci.json

# Local secrets and Claude Code machine overrides — never commit
.env
.env.local
.env.*.local
# Container-injected agent-surface config (Cursor-Governance#281). The Claude
# Code cloud session writes these into every consumer clone; nothing here has
# ever been tracked (`git ls-files .claude .mcp.json` = 0, no history). Leaving
# them unignored makes every session report a dirty tree and fails this repo's
# ruff gate on an injected hook file that is not repo content.
.claude/
.mcp.json
.l9-worktrees/

# Safe Haven Golden run evidence and calibration fixtures (generated per run)
evidence/
tests/golden/safehaven/fixtures/
